// Badi Palace Museum — booking + checkout schema (PostgreSQL / Supabase ready)
//
// The storefront legacy catalogue (products, sessions, PDF inventory) is kept so the
// existing admin tooling remains usable, while the museum booking domain lives on
// Order (visitDate, adultQty, childQty), ClosedDate, WeeklyClosure and Setting.
//
// All money is stored in minor units (euro cents). Visit dates are stored as DATE at
// UTC midnight and formatted in Africa/Casablanca for display.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On serverless hosts (Vercel) point this at the pooled
  // endpoint (Neon `-pooler`, Supabase pgbouncer) with `?pgbouncer=true&connection_limit=1`.
  url      = env("DATABASE_URL")
  // Migrations only (`prisma migrate deploy`). Use the direct/unpooled endpoint
  // because transaction poolers do not support the DDL statements Prisma runs.
  // Locally this is the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- constants

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

// Model A: one PDF == one ticket. Model B: one PDF == a group delivered together.
enum InventoryModel {
  ONE_PDF_PER_TICKET
  ONE_PDF_PER_GROUP
}

enum TicketInventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  FAILED_DELIVERY
  RETIRED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DELIVERY_FAILED
}

enum DeliveryStatus {
  NOT_REQUIRED
  PENDING
  QUEUED
  SENT
  PARTIALLY_SENT
  FAILED
}

enum PaymentEnvironment {
  SANDBOX
  LIVE
}

enum PaymentStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  DENIED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum WebhookStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
  SIGNATURE_INVALID
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum EncryptionMode {
  NONE
  TLS
  STARTTLS
}

enum AuditActorType {
  ADMIN
  SYSTEM
  CRON
  GUEST
}

enum StorageProvider {
  LOCAL
  S3
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD
}

/** TICKET = legacy PDF catalogue order, MUSEUM = dated museum entrance tickets. */
enum OrderKind {
  TICKET
  MUSEUM
}

// ---------------------------------------------------------------- auth

model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique @db.VarChar(191)
  name            String    @db.VarChar(120)
  passwordHash    String    @db.VarChar(255)
  role            AdminRole @default(ADMIN)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  passwordChanged DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions AdminSession[]
  audits   AuditLog[]

  @@index([role, isActive])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.VarChar(64)
  adminUserId String
  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(300)
  createdAt   DateTime  @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

// Durable fixed-window counters for login and sensitive endpoints.
model RateLimitBucket {
  id           String    @id @default(cuid())
  key          String    @unique @db.VarChar(191)
  count        Int       @default(1)
  windowStart  DateTime  @default(now())
  resetAt      DateTime
  blockedUntil DateTime?

  @@index([resetAt])
}

// ---------------------------------------------------------------- catalog

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id                    String         @id @default(cuid())
  slug                  String         @unique @db.VarChar(160)
  name                  String         @db.VarChar(160)
  shortDescription      String         @db.VarChar(300)
  description           String         @db.Text
  categoryId            String?
  status                ProductStatus  @default(DRAFT)
  // Minor units (cents/pence) so no float money math happens anywhere.
  priceMinor            Int
  currency              String         @default("USD") @db.VarChar(3)
  taxRateBps            Int            @default(0)
  taxIncluded           Boolean        @default(false)
  inventoryModel        InventoryModel @default(ONE_PDF_PER_TICKET)
  minTickets            Int            @default(1)
  maxTickets            Int            @default(10)
  // Session-less products sell from a product-wide pool.
  requiresSession       Boolean        @default(true)
  salesStartAt          DateTime?
  salesEndAt            DateTime?
  lowInventoryThreshold Int            @default(10)
  sortOrder             Int            @default(0)
  search                String         @default("") @db.VarChar(255)
  archivedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  category   Category?         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  sessions   EventSession[]
  inventory  TicketInventory[]
  orderLines OrderLine[]

  @@index([status, slug])
  @@index([categoryId])
  @@index([priceMinor])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  storageKey String   @db.VarChar(191)
  alt        String   @default("") @db.VarChar(160)
  width      Int?
  height     Int?
  fileSize   Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// A bookable date + time window. Inventory is scoped per session so a ticket for
// one session can never be allocated to another.
model EventSession {
  id        String   @id @default(cuid())
  productId String
  date      DateTime
  startTime String   @db.VarChar(5) // "14:00" in store timezone; text survives DST
  endTime   String?  @db.VarChar(5)
  label     String?  @db.VarChar(80)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory TicketInventory[]

  @@unique([productId, date, startTime])
  @@index([productId, date])
}

// ---------------------------------------------------------------- inventory

model TicketInventory {
  id               String                @id @default(cuid())
  productId        String
  eventSessionId   String?
  status           TicketInventoryStatus @default(AVAILABLE)
  storageKey       String                @db.VarChar(191)
  originalFileName String                @db.VarChar(160)
  fileSize         Int
  mimeType         String                @default("application/pdf") @db.VarChar(80)
  checksum         String                @db.VarChar(64) // sha256 of bytes; rejects duplicate uploads
  ticketCount      Int                   @default(1) // >1 only for ONE_PDF_PER_GROUP
  reservationId    String?
  orderId          String?
  reservedUntil    DateTime?
  allocatedAt      DateTime?
  deliveredAt      DateTime?
  lastError        String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  product      Product       @relation(fields: [productId], references: [id])
  eventSession EventSession? @relation(fields: [eventSessionId], references: [id])
  reservation  Reservation?  @relation(fields: [reservationId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])

  // Claim path: find and flip AVAILABLE rows for one product/session.
  @@index([productId, eventSessionId, status])
  @@index([status, reservedUntil])
  @@index([reservationId])
  @@index([orderId])
  @@index([checksum])
}

model Reservation {
  id          String            @id @default(cuid())
  code        String            @unique @db.VarChar(64) // opaque, handed to the browser
  orderId     String?
  ticketCount Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  inventory TicketInventory[]

  @@index([status, expiresAt])
  @@index([orderId])
}

// ---------------------------------------------------------------- people + orders

model Customer {
  id                 String    @id @default(cuid())
  emailNormalized    String    @unique @db.VarChar(200)
  emailOriginal      String    @db.VarChar(200)
  fullName           String    @db.VarChar(160)
  phone              String?   @db.VarChar(40)
  firstPurchaseAt    DateTime?
  lastPurchaseAt     DateTime?
  totalOrders        Int       @default(0)
  totalSpentMinor    Int       @default(0)
  totalRefundedMinor Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders Order[]

  @@index([fullName])
}

model Order {
  id                   String              @id @default(cuid())
  publicId             String              @unique @db.VarChar(40) // random, shareable, non-sequential
  reference            String              @unique @db.VarChar(40) // human receipt number
  customerId           String?
  customerEmail        String              @db.VarChar(200)
  customerName         String              @db.VarChar(160)
  customerPhone        String?             @db.VarChar(40)
  kind                 OrderKind           @default(TICKET)
  status               OrderStatus         @default(PENDING)
  deliveryStatus       DeliveryStatus      @default(PENDING)
  currency             String              @default("USD") @db.VarChar(3)
  subtotalMinor        Int                 @default(0)
  taxMinor             Int                 @default(0)
  totalMinor           Int                 @default(0)
  refundedMinor        Int                 @default(0)
  paymentEnvironment   PaymentEnvironment?
  paypalOrderId        String?             @db.VarChar(64)
  paypalCaptureId      String?             @db.VarChar(64)
  reservationId        String?
  reservationExpiresAt DateTime?
  paidAt               DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  // Snapshot so history survives product edits and price changes.
  sessionSummary       String              @default("") @db.VarChar(255)
  // Museum booking fields. totalMinor doubles as the prompt's totalCents.
  visitDate            DateTime?           @db.Date
  adultQty             Int                 @default(0)
  childQty             Int                 @default(0)
  checkedInAt          DateTime?
  checkedInBy          String?             @db.VarChar(191)
  internalNotes        String              @default("") @db.Text
  idempotencyKey       String?             @unique @db.VarChar(120)
  clientIp             String?             @db.VarChar(64)
  userAgent            String?             @db.VarChar(300)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer Customer?             @relation(fields: [customerId], references: [id])
  lines    OrderLine[]
  payments Payment[]
  refunds  Refund[]
  tickets  TicketInventory[]
  emails   EmailDelivery[]
  webhooks PaymentWebhookEvent[]

  @@index([customerEmail])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([kind, visitDate])
  @@index([visitDate, status])
  @@index([checkedInAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  eventSessionId String?
  productName    String  @db.VarChar(160)
  priceMinor     Int
  quantity       Int
  lineTotalMinor Int
  currency       String  @db.VarChar(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------- payments

model Payment {
  id            String             @id @default(cuid())
  orderId       String
  provider      String             @default("PAYPAL") @db.VarChar(40)
  environment   PaymentEnvironment
  status        PaymentStatus
  paypalOrderId String?            @db.VarChar(64)
  // Unique where MySQL allows repeated NULLs, so a capture id can never be recorded twice.
  captureId     String?            @unique @db.VarChar(64)
  amountMinor   Int
  currency      String             @db.VarChar(3)
  raw           Json?
  error         String?            @db.Text
  createdAt     DateTime           @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paypalOrderId])
}

model PaymentWebhookEvent {
  id           String        @id @default(cuid())
  eventId      String        @unique @db.VarChar(120) // PayPal event id == idempotency key
  eventType    String        @db.VarChar(80)
  status       WebhookStatus
  resourceType String?       @db.VarChar(40)
  orderId      String?
  payload      Json
  error        String?       @db.Text
  receivedAt   DateTime      @default(now())
  processedAt  DateTime?

  order Order? @relation(fields: [orderId], references: [id])

  @@index([eventType, receivedAt])
  @@index([status])
}

model Refund {
  id             String             @id @default(cuid())
  orderId        String
  captureId      String             @db.VarChar(64)
  paypalRefundId String?            @db.VarChar(64)
  amountMinor    Int
  currency       String             @db.VarChar(3)
  environment    PaymentEnvironment
  status         PaymentStatus      @default(CREATED)
  reason         String?            @db.VarChar(300)
  requestedBy    String?
  raw            Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paypalRefundId])
}

// ---------------------------------------------------------------- email

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(60) // ORDER_CONFIRMATION, TICKET_DELIVERY, ...
  name      String   @db.VarChar(120)
  subject   String   @db.VarChar(255)
  htmlBody  String   @db.Text
  textBody  String   @db.Text
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model EmailDelivery {
  id             String              @id @default(cuid())
  orderId        String?
  idempotencyKey String              @unique @db.VarChar(191) // prevents double delivery of one order
  templateKey    String              @db.VarChar(60)
  to             String              @db.VarChar(200)
  toName         String?             @db.VarChar(160)
  ccAdmin        Boolean             @default(false)
  subject        String              @db.VarChar(255)
  html           String              @db.Text
  text           String              @db.Text
  status         EmailDeliveryStatus @default(QUEUED)
  attempts       Int                 @default(0)
  lastError      String?             @db.Text
  nextRetryAt    DateTime?
  sentAt         DateTime?
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order       Order?            @relation(fields: [orderId], references: [id])
  attachments EmailAttachment[]

  @@index([status, nextRetryAt])
  @@index([orderId])
}

// MySQL has no array columns, so the attachment list is a real child table and every
// ticket file referenced by a delivery is protected by a foreign key.
model EmailAttachment {
  id         String @id @default(cuid())
  deliveryId String
  storageKey String @db.VarChar(191)
  fileName   String @default("") @db.VarChar(160)
  sortOrder  Int    @default(0)

  delivery EmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, sortOrder])
}

// ---------------------------------------------------------------- settings

// Secrets are AES-256-GCM encrypted with SMTP_ENCRYPTION_KEY before they are written.
model PayPalSettings {
  id                  String             @id @default(cuid())
  key                 String             @unique @default("singleton") @db.VarChar(20)
  enabled             Boolean            @default(false)
  environment         PaymentEnvironment @default(SANDBOX)
  sandboxClientId     String?            @db.VarChar(200)
  sandboxClientSecret String?            @db.Text // encrypted
  liveClientId        String?            @db.VarChar(200)
  liveClientSecret    String?            @db.Text // encrypted
  webhookIdSandbox    String?            @db.VarChar(200)
  webhookIdLive       String?            @db.VarChar(200)
  currency            String             @default("USD") @db.VarChar(3)
  lastTestAt          DateTime?
  lastTestOk          Boolean?
  lastTestError       String?            @db.Text
  updatedAt           DateTime           @updatedAt
  updatedBy           String?
}

model SmtpSettings {
  id              String         @id @default(cuid())
  key             String         @unique @default("singleton") @db.VarChar(20)
  enabled         Boolean        @default(false)
  host            String?        @db.VarChar(200)
  port            Int            @default(587)
  encryption      EncryptionMode @default(STARTTLS)
  username        String?        @db.VarChar(200)
  password        String?        @db.Text // encrypted
  senderName      String?        @db.VarChar(120)
  senderEmail     String?        @db.VarChar(200)
  replyToEmail    String?        @db.VarChar(200)
  allowSelfSigned Boolean        @default(false)
  pool            Boolean        @default(true)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestError   String?        @db.Text
  updatedAt       DateTime       @updatedAt
  updatedBy       String?
}

model GeneralSettings {
  id                   String          @id @default(cuid())
  key                  String          @unique @default("singleton") @db.VarChar(20)
  storeName            String          @default("Tixora") @db.VarChar(120)
  storeLogoKey         String?         @db.VarChar(191)
  supportEmail         String          @default("support@example.com") @db.VarChar(200)
  supportPhone         String?         @db.VarChar(60)
  storeAddress         String?         @db.VarChar(400)
  timezone             String          @default("UTC") @db.VarChar(60)
  defaultCurrency      String          @default("USD") @db.VarChar(3)
  taxRateBps           Int             @default(0)
  taxLabel             String          @default("Tax") @db.VarChar(40)
  receiptPrefix        String          @default("TXA") @db.VarChar(8)
  receiptCounter       Int             @default(0)
  reservationMinutes   Int             @default(15)
  maxTicketsPerOrder   Int             @default(10)
  requirePhone         Boolean         @default(false)
  billingRequired      Boolean         @default(false)
  emailBrandingName    String?         @db.VarChar(120)
  emailBrandingLogoUrl String?         @db.VarChar(500)
  maintenanceMode      Boolean         @default(false)
  privacyUrl           String          @default("/privacy") @db.VarChar(191)
  termsUrl             String          @default("/terms") @db.VarChar(191)
  privacyPolicy        String          @default("") @db.Text
  termsAndConditions   String          @default("") @db.Text
  storageProvider      StorageProvider @default(LOCAL)
  updatedAt            DateTime        @updatedAt
  updatedBy            String?
}

// ---------------------------------------------------------------- museum booking

/** A single date the museum is closed (holiday, private event, maintenance). */
model ClosedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String   @default("") @db.VarChar(300)
  createdBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())

  @@index([date])
}

/** Recurring weekly closure, 0 = Sunday … 6 = Saturday. */
model WeeklyClosure {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  reason    String   @default("") @db.VarChar(300)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Key/value configuration for the museum domain (prices, capacity, cutoff, i18n).
 * Keeping it generic means new operational knobs do not require a migration.
 */
model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedBy String?  @db.VarChar(191)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- operations

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  actorLabel String?        @db.VarChar(200)
  action     String         @db.VarChar(100) // e.g. ORDER_REFUND, INVENTORY_UPLOAD
  entityType String         @db.VarChar(60)
  entityId   String?        @db.VarChar(64)
  summary    String         @db.VarChar(500)
  metadata   Json?
  ip         String?        @db.VarChar(64)
  userAgent  String?        @db.VarChar(300)
  createdAt  DateTime       @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([action])
}

// DB-backed queue so delivery survives process restarts and can be retried.
model DeliveryJob {
  id          String    @id @default(cuid())
  kind        String    @db.VarChar(50) // EMAIL_DELIVERY, RESERVATION_RELEASE
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedUntil DateTime?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedUntil])
}
