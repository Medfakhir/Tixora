# ---------------------------------------------------------------------------
# Badi Palace Museum — booking app for book.visitbadipalace.com
#
# Copy to .env and fill in. Never commit a filled .env.
#
# Generate secrets with:
#   openssl rand -base64 48   ->  AUTH_SECRET (or NEXTAUTH_SECRET)
#   openssl rand -hex 32      ->  SMTP_ENCRYPTION_KEY (must be 64 hex chars)
#   openssl rand -hex 24      ->  CRON_SECRET
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV="development"
# Public origin. PayPal return URLs, QR links and email links use this value.
APP_URL="http://localhost:3000"

# Database — PostgreSQL 14+ (local Postgres, Supabase, Neon, Railway, RDS…).
# The test database name must contain "test": `npm test` truncates it.
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/kibir?schema=public"
DATABASE_URL_TEST="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/kibir_test?schema=public"

# Migrations only. Locally, repeat DATABASE_URL. On serverless hosts this must be
# the DIRECT (unpooled) URL, because transaction poolers reject the DDL Prisma runs.
#   Neon:     DATABASE_URL uses the "-pooler" host, DIRECT_URL uses the plain host
#   Supabase: DATABASE_URL uses the "pooler." host (port 6543, ?pgbouncer=true),
#             DIRECT_URL uses "db.<ref>.supabase.co" (port 5432)
DIRECT_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/kibir?schema=public"

# Optional: only used by `npm run setup:db` to create both databases. The role
# needs CREATE DATABASE. With Supabase, create the databases in the dashboard
# and leave this unset.
# POSTGRES_ADMIN_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres"

# Session signing and token hashing. AUTH_SECRET is preferred; NEXTAUTH_SECRET
# is accepted as an alias so existing NextAuth-style deployments can reuse it.
AUTH_SECRET="replace-with-openssl-rand-base64-48"
# NEXTAUTH_SECRET="replace-with-openssl-rand-base64-48"

# AES-256-GCM key for PayPal/SMTP secrets stored in the database.
# Keep it stable and back it up with the database; changing it makes stored
# credentials unreadable and the app falls back to environment values.
SMTP_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Protects POST /api/cron/expire-reservations (Authorization: Bearer <value>)
CRON_SECRET="replace-with-openssl-rand-hex-24"

# PayPal — official Orders v2 API.
# PAYPAL_MODE selects which generic pair below is used (sandbox | live).
# Values saved in Admin -> Settings -> PayPal take precedence and are encrypted.
# The environment values are an explicit deployment-level opt-in and work even
# when the database toggle is off.
PAYPAL_MODE="sandbox"
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_WEBHOOK_ID=""

# Optional explicit per-environment fallbacks (legacy names are still accepted):
# PAYPAL_SANDBOX_CLIENT_ID=""
# PAYPAL_SANDBOX_CLIENT_SECRET=""
# PAYPAL_SANDBOX_WEBHOOK_ID=""
# PAYPAL_LIVE_CLIENT_ID=""
# PAYPAL_LIVE_CLIENT_SECRET=""
# PAYPAL_LIVE_WEBHOOK_ID=""

# Email — Resend is preferred when RESEND_API_KEY is present. Without it the
# app falls back to the SMTP settings saved in the admin UI. Confirmation
# emails embed the booking QR code, so one provider must be configured.
#
# Free test inbox (no signup, nothing delivered to real addresses):
#   Ethereal — open https://ethereal.email/, click "Create Ethereal Account",
#   then in Admin -> Settings -> SMTP use:
#     Host: smtp.ethereal.email   Port: 587   Encryption: STARTTLS
#     Username / Password: the values Ethereal shows
#   Every message is captured at https://ethereal.email/messages.
#   Mailtrap (https://mailtrap.io) works the same way with its own host/port.
# RESEND_API_KEY="re_..."
# RESEND_FROM="Badi Palace Museum <tickets@visitbadipalace.com>"

# First administrator, read once by `npm run db:seed`. There are no default
# credentials: if these are absent and no admin exists, the seed refuses to run.
INITIAL_ADMIN_EMAIL="owner@example.com"
INITIAL_ADMIN_NAME="Owner"
INITIAL_ADMIN_PASSWORD="at-least-12-characters"

# Optional sample museum bookings for the dashboard/calendar/check-in screens.
# Only created on an empty database when set to 1. Never use in production.
# SEED_DEMO="1"

# Testing only: adds a "Simulate payment (test mode)" button at checkout that marks
# the order paid server-side without contacting PayPal, so the confirmation email and
# success page can be tested before real credentials exist. Strictly opt-in; leave
# unset (or "false") on any deployment that sells real tickets.
# DEMO_PAYMENTS="true"

# Legacy ticket-PDF storage. Museum bookings do not need it, but the original
# catalogue and PDF inventory remain available. LOCAL keeps files outside the
# web root; S3 works with any S3-compatible bucket.
STORAGE_PROVIDER="LOCAL"
STORAGE_LOCAL_DIR="./storage/private"
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_ENDPOINT=""   # R2 / MinIO / Spaces; leave empty for AWS
