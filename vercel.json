{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"no dependencies to install\"",
  "buildCommand": "echo \"no build step\"",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/cron/reconcile.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 3 * * *"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}